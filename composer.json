{
    "name": "slipstream/slipstream",
    "description": "Open-source zero-downtime deploy platform for Laravel (Envoyer-style, no SSH)",
    "keywords": ["laravel", "deploy", "zero-downtime", "envoyer", "webhook"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/forthmediallc/SlipStream",
    "support": {
        "issues": "https://github.com/forthmediallc/SlipStream/issues",
        "source": "https://github.com/forthmediallc/SlipStream"
    },
    "authors": [
        {
            "name": "Slipstream"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/encryption": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.8.3|^4.3.4",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "suggest": {
        "ext-sodium": "Required on nodes that deploy artifact releases (Ed25519 signature verification) and in CI to sign with a local key",
        "ext-zlib": "Required to package and unpack artifact releases (release.tar.gz)",
        "league/flysystem-aws-s3-v3": "To keep artifact releases in S3 (the artifacts disk)"
    },
    "autoload": {
        "psr-4": {
            "Slipstream\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slipstream\\Tests\\": "tests/",
            "Slipstream\\Preview\\": "preview/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Slipstream\\SlipstreamServiceProvider"
            ],
            "aliases": {
                "Slipstream": "Slipstream\\Facades\\Slipstream"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stub:build": "@php stubs/src/build-release-tool.php",
        "preview:build": [
            "@php vendor/bin/testbench vendor:publish --tag=slipstream-assets --force --ansi",
            "@php vendor/bin/testbench migrate:fresh --force --ansi",
            "@php vendor/bin/testbench db:seed --class=Slipstream\\Preview\\PreviewSeeder --force --ansi"
        ],
        "preview": "@php vendor/bin/testbench serve"
    }
}
